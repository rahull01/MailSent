# MailSent — environment (copy to .env for local setup)
# References ONLY placeholders; no real secrets. Values are injected by
# docker-compose / CI. See the frozen docs for the source of truth.

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mailsent
POSTGRES_USER=mailsent
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080