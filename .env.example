# MailSent — environment template (copy to .env and fill in real values).
# No secrets should remain in this file.  docker-compose.yml will FAIL
# if the required variables below are not set.

# PostgreSQL (REQUIRED — compose will fail if unset)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=<required>
POSTGRES_USER=<required>
POSTGRES_PASSWORD=<required>

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080
# SPRING_PROFILES_ACTIVE is set to 'prod' in docker-compose.yml.
# For local development, run the backend directly outside Docker.

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080