# MailSent — repository attribute defaults (text normalization)
* text=auto eol=lf

# Scripts and config must stay LF
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.java text eol=lf

# Windows command scripts
*.bat text eol=crlf

# Binary blobs: never normalize
*.png binary
*.jpg binary
*.jar binary
*.class binary