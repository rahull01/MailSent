# MailSent — Repository standards (REPO-007)
# Repository-wide defaults. This file standardizes core text properties for the
# whole repository. No language-specific formatting is set here; language
# style is governed separately, once a stack is chosen.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
