# MailSent — .gitignore
# Repository-wide ignore rules (Phase 00, REPO-000/REPO-001).
# Secrets and credentials are NEVER committed. The secrets guard
# (scripts/guard-secrets.sh) enforces this; this file is the first line.

# ---- Credentials / secrets (never commit) ----
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
.secrets
secrets.yaml
secrets.yml
config/credentials*
!*.example

# Local tool credential stores that must not enter the repository
.jetro/

# ---- Operating system ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Editors / IDEs ----
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo

# ---- Build / dependency outputs ----
node_modules/
vendor/
dist/
build/
out/
target/
bin/
*.class
*.jar
*.war
coverage/
.hypothesis/

# ---- Language caches ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Logs / runtime ----
*.log
logs/
tmp/
.pids
.pid

# ---- Environment-local ----
.local/
.verdent/

# ---- Keep a placeholder example pattern visible ----
# Add repo-specific ignore rules below this line.

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# Codex local configuration
.codex/
# Claude Flow runtime data
# Environment variables

# ---- Local Generated / Temporary Artifacts ----
.swarm/
ruvector.db
*.db-shm
*.db-wal
backend/causes.txt
backend/first_130.txt
backend/h2_test_output.txt
jhgfd
.claude-flow/
.mcp.json
.cursor/mcp.json
.claude/settings.local.json
backend/extract.py
backend/extract_surefire.py
